# Declares the non-secret app environment variables as code so they're reapplied
# from source on every deploy. Elastic Beanstalk auto-reverts config changes made
# out-of-band (console/CLI) whenever a deploy fails for any reason, even one
# unrelated to the changed value - a manually-set var can silently disappear on
# the next failed deploy. Sensitive values (DB credentials themselves) stay in
# Secrets Manager; this only holds the ARN/identifiers needed to look them up.
option_settings:
  aws:elasticbeanstalk:application:environment:
    AWS_REGION: ap-south-1
    # Enables POST /v1/auth/dev-token for testing from Swagger without a real
    # Cognito/Apple/Google sign-in. Dev environment only — never add this key to a
    # prod environment's config.
    DEV_AUTH_ENABLED: "true"
    APPLE_BUNDLE_ID: in.aryapet.horizon.dev
    COGNITO_USER_POOL_ID: ap-south-1_Tt3OsckDn
    COGNITO_APP_CLIENT_ID: 1sffmjekmfpn0n6eoelmqrp70i
    DB_SECRET_ARN: arn:aws:secretsmanager:ap-south-1:188620291813:secret:arya/rds-dev-EwdXVt
    S3_DOCUMENTS_BUCKET: arya-dev-documents-188620291813
    SQS_PROCESSING_QUEUE_URL: https://sqs.ap-south-1.amazonaws.com/188620291813/arya-dev-processing

  # Bumped from t3.micro: the worker now loads two self-hosted HuggingFace models
  # (~900MB combined - see app/services/document_classifier.py) alongside the API
  # process, which t3.micro's 1GB RAM can't hold. This is a real recurring cost
  # increase (t3.micro ~$8-9/mo -> t3.large ~$60-70/mo in ap-south-1).
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.large
