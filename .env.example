ENVIRONMENT=dev
AWS_REGION=ap-south-1

# Secrets Manager secret holding RDS credentials (JSON: username, password, host, port, dbname, engine).
# Accepts either a friendly secret name or a full ARN.
DB_SECRET_ARN=arya/rds-dev

# Optional: skip Secrets Manager and connect directly, e.g. for local Postgres via docker-compose
# DATABASE_URL=postgresql+asyncpg://arya:arya@localhost:5432/arya

COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-south-1

# Enables POST /v1/auth/dev-token for minting a self-signed bearer token (bypasses
# Cognito/Apple) to paste into Swagger's Authorize button. Leave unset/false in prod.
DEV_AUTH_ENABLED=false

# Bundle id of the iOS app, e.g. com.aryapet.mvp — must match the `aud` claim on Sign in
# with Apple identity tokens.
APPLE_BUNDLE_ID=com.aryapet.mvp

S3_DOCUMENTS_BUCKET=arya-dev-documents-<account_id>

SQS_PROCESSING_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account_id>/arya-dev-processing
SQS_PROCESSING_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<account_id>/arya-dev-processing-dlq

SNS_PLATFORM_APPLICATION_ARN=
